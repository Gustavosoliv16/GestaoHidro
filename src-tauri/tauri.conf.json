{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestão HydroFit",
  "version": "1.2.5",
  "identifier": "com.hydrofit.gestao",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gestão HydroFit",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "HydroFit",
    "copyright": "Copyright © 2026 HydroFit. Todos os direitos reservados.",
    "category": "Business",
    "shortDescription": "Sistema de gestão para escolas de hidroginástica",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}